{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ccharon/factorio-calculator/src/data/dataset.schema.json",
  "title": "Factorio calculator dataset",
  "description": "Game data for one Factorio version with Space Age, generated by tools/build-data.ts. Energy is in joules, power in watts, time in seconds unless a field name says ticks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "groups", "items", "fluids", "fuel", "spoilage", "recipes", "crafting_machines",
    "rocket_silo", "mining_drills", "offshore_pumps", "boilers", "generators", "solar_panels", "reactors", "fusion_reactors", "fusion_generators", "belts", "beacon", "modules",
    "agricultural_tower", "planets", "resources", "plants", "surface_properties", "recipe_productivity", "qualities", "rocket_lift_weight", "sprites"
  ],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$", "description": "Game version the data was dumped from." },
    "groups": {
      "description": "Item groups keyed by name, with their subgroups and sort orders.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "subgroups"],
        "properties": {
          "order": { "type": "string" },
          "subgroups": { "type": "object", "additionalProperties": { "type": "string" } }
        }
      }
    },
    "items": {
      "description": "All items and fluids. Fluids have type \"fluid\".",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "localized_name", "type", "group", "subgroup", "order", "icon_col", "icon_row"],
        "properties": {
          "key": { "$ref": "#/$defs/key" },
          "localized_name": { "$ref": "#/$defs/localizedName" },
          "type": { "type": "string", "description": "Prototype type, such as item, module, tool or fluid." },
          "group": { "type": "string" },
          "subgroup": { "type": "string" },
          "order": { "type": "string" },
          "stack_size": { "type": "integer", "minimum": 1 },
          "weight": { "type": "number", "minimum": 0, "description": "Weight in grams, which limits rocket cargo." },
          "spoil_ticks": { "type": "integer", "minimum": 1, "description": "Ticks until the item spoils. Absent for items that do not spoil." },
          "icon_col": { "$ref": "#/$defs/iconIndex" },
          "icon_row": { "$ref": "#/$defs/iconIndex" }
        }
      }
    },
    "fluids": {
      "description": "Thermal properties of fluids. heat_capacity is in J per unit per degree.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_key", "default_temperature", "heat_capacity"],
        "properties": {
          "item_key": { "$ref": "#/$defs/key" },
          "default_temperature": { "type": "number" },
          "max_temperature": { "type": "number" },
          "heat_capacity": { "type": "number", "exclusiveMinimum": 0 },
          "fuel_value": { "type": "number", "minimum": 0 }
        }
      }
    },
    "fuel": {
      "description": "Items that can be burned. value is in J per item.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_key", "categories", "value"],
        "properties": {
          "item_key": { "$ref": "#/$defs/key" },
          "categories": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Fuel categories, such as chemical or nutrients." },
          "value": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "spoilage": {
      "description": "Items that spoil into another item after time ticks.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from_item", "to_item", "time"],
        "properties": {
          "from_item": { "$ref": "#/$defs/key" },
          "to_item": { "$ref": "#/$defs/key" },
          "time": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "recipes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "localized_name", "categories", "energy_required", "allow_productivity", "allow_quality", "ingredients", "results", "order", "subgroup", "icon_col", "icon_row"],
        "properties": {
          "key": { "$ref": "#/$defs/key" },
          "localized_name": { "$ref": "#/$defs/localizedName" },
          "categories": { "type": "array", "items": { "type": "string" }, "minItems": 1, "description": "Any machine with one of these crafting categories can make the recipe." },
          "energy_required": { "type": "number", "exclusiveMinimum": 0, "description": "Crafting time in seconds at crafting speed 1." },
          "allow_productivity": { "type": "boolean" },
          "allow_quality": { "type": "boolean", "description": "Whether quality effects can raise the quality of the products." },
          "maximum_productivity": { "type": "number", "description": "Productivity cap. The game default is 3 (+300%)." },
          "ingredients": { "type": "array", "items": { "$ref": "#/$defs/ingredient" } },
          "results": { "type": "array", "items": { "$ref": "#/$defs/product" } },
          "main_product": { "$ref": "#/$defs/key" },
          "surface_conditions": { "$ref": "#/$defs/surfaceConditions" },
          "order": { "type": "string" },
          "subgroup": { "type": "string" },
          "hidden": { "const": true },
          "icon_col": { "$ref": "#/$defs/iconIndex" },
          "icon_row": { "$ref": "#/$defs/iconIndex" }
        }
      }
    },
    "crafting_machines": {
      "type": "array",
      "items": {
        "type": "object",
        "allOf": [{ "$ref": "#/$defs/machine" }],
        "required": ["crafting_categories", "crafting_speed", "prod_bonus"],
        "properties": {
          "crafting_categories": { "type": "array", "items": { "type": "string" } },
          "crafting_speed": { "type": "number", "exclusiveMinimum": 0 },
          "crafting_speed_by_quality": { "type": "object", "additionalProperties": { "type": "number", "exclusiveMinimum": 0 }, "description": "Crafting speed by quality key." },
          "prod_bonus": { "type": "number", "minimum": 0, "description": "Built-in productivity bonus, such as 0.5 for the foundry." }
        },
        "unevaluatedProperties": false
      }
    },
    "rocket_silo": {
      "type": "array",
      "items": {
        "type": "object",
        "allOf": [{ "$ref": "#/$defs/machine" }],
        "required": ["crafting_categories", "crafting_speed", "rocket_parts_required", "launch_by_quality"],
        "properties": {
          "crafting_categories": { "type": "array", "items": { "type": "string" } },
          "crafting_speed": { "type": "number", "exclusiveMinimum": 0 },
          "crafting_speed_by_quality": { "type": "object", "additionalProperties": { "type": "number", "exclusiveMinimum": 0 }, "description": "Crafting speed by quality key." },
          "rocket_parts_required": { "type": "integer", "minimum": 1 },
          "launch_by_quality": {
            "type": "object",
            "minProperties": 1,
            "description": "Launch sequence in ticks by quality key, measured in the game.",
            "additionalProperties": {
              "type": "object",
              "required": ["flight", "quick", "lights", "reopen", "doors", "full"],
              "properties": {
                "flight": { "type": "integer", "minimum": 1 },
                "quick": { "type": "integer", "minimum": 1 },
                "lights": { "type": "integer", "minimum": 1 },
                "reopen": { "type": "array", "items": { "type": "array", "prefixItems": [{ "type": "integer" }, { "type": "integer" }], "minItems": 2, "maxItems": 2 } },
                "doors": { "type": "integer", "minimum": 1 },
                "full": { "type": "integer", "minimum": 1 }
              },
              "additionalProperties": false
            }
          }
        },
        "unevaluatedProperties": false
      }
    },
    "mining_drills": {
      "type": "array",
      "items": {
        "type": "object",
        "allOf": [{ "$ref": "#/$defs/machine" }],
        "required": ["mining_speed", "resource_categories", "takes_fluid"],
        "properties": {
          "mining_speed": { "type": "number", "exclusiveMinimum": 0 },
          "resource_categories": { "type": "array", "items": { "type": "string" } },
          "resource_drain_rate_percent": { "type": "number", "description": "Share of mined resources taken from the patch, such as 50 for the big mining drill." },
          "takes_fluid": { "type": "boolean" }
        },
        "unevaluatedProperties": false
      }
    },
    "offshore_pumps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "localized_name", "pumping_speed", "icon_col", "icon_row"],
        "properties": {
          "key": { "$ref": "#/$defs/key" },
          "localized_name": { "$ref": "#/$defs/localizedName" },
          "pumping_speed": { "type": "number", "exclusiveMinimum": 0, "description": "Fluid units per tick." },
          "icon_col": { "$ref": "#/$defs/iconIndex" },
          "icon_row": { "$ref": "#/$defs/iconIndex" }
        }
      }
    },
    "boilers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "localized_name", "energy_consumption", "energy_source", "target_temperature", "icon_col", "icon_row"],
        "properties": {
          "key": { "$ref": "#/$defs/key" },
          "localized_name": { "$ref": "#/$defs/localizedName" },
          "energy_consumption": { "type": "number", "exclusiveMinimum": 0 },
          "energy_source": { "$ref": "#/$defs/energySource" },
          "target_temperature": { "type": "number" },
          "icon_col": { "$ref": "#/$defs/iconIndex" },
          "icon_row": { "$ref": "#/$defs/iconIndex" }
        }
      }
    },
    "generators": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "localized_name", "fluid", "fluid_usage", "maximum_temperature", "effectivity", "icon_col", "icon_row"],
        "properties": {
          "key": { "$ref": "#/$defs/key" },
          "localized_name": { "$ref": "#/$defs/localizedName" },
          "fluid": { "$ref": "#/$defs/key" },
          "fluid_usage": { "type": "number", "exclusiveMinimum": 0, "description": "Fluid units per second at full output." },
          "maximum_temperature": { "type": "number" },
          "effectivity": { "type": "number", "exclusiveMinimum": 0 },
          "icon_col": { "$ref": "#/$defs/iconIndex" },
          "icon_row": { "$ref": "#/$defs/iconIndex" }
        }
      }
    },
    "solar_panels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "localized_name", "production", "icon_col", "icon_row"],
        "properties": {
          "key": { "$ref": "#/$defs/key" },
          "localized_name": { "$ref": "#/$defs/localizedName" },
          "production": { "type": "number", "exclusiveMinimum": 0, "description": "Peak output in W." },
          "surface_conditions": { "$ref": "#/$defs/surfaceConditions" },
          "icon_col": { "$ref": "#/$defs/iconIndex" },
          "icon_row": { "$ref": "#/$defs/iconIndex" }
        }
      }
    },
    "reactors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "localized_name", "consumption", "neighbour_bonus", "energy_source", "icon_col", "icon_row"],
        "properties": {
          "key": { "$ref": "#/$defs/key" },
          "localized_name": { "$ref": "#/$defs/localizedName" },
          "consumption": { "type": "number", "exclusiveMinimum": 0, "description": "Heat output in W." },
          "neighbour_bonus": { "type": "number", "minimum": 0, "description": "Extra heat output per active neighbouring reactor, such as 1 for +100%." },
          "energy_source": { "$ref": "#/$defs/energySource" },
          "icon_col": { "$ref": "#/$defs/iconIndex" },
          "icon_row": { "$ref": "#/$defs/iconIndex" }
        }
      }
    },
    "fusion_reactors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "localized_name", "power_input", "fluid_usage", "input_fluid", "output_fluid", "burner", "icon_col", "icon_row"],
        "properties": {
          "key": { "$ref": "#/$defs/key" },
          "localized_name": { "$ref": "#/$defs/localizedName" },
          "power_input": { "type": "number", "exclusiveMinimum": 0, "description": "Electric power in W." },
          "fluid_usage": { "type": "number", "exclusiveMinimum": 0, "description": "Fluid units per second." },
          "input_fluid": { "$ref": "#/$defs/key" },
          "output_fluid": { "$ref": "#/$defs/key" },
          "burner": { "$ref": "#/$defs/energySource" },
          "icon_col": { "$ref": "#/$defs/iconIndex" },
          "icon_row": { "$ref": "#/$defs/iconIndex" }
        }
      }
    },
    "fusion_generators": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "localized_name", "max_power_output", "fluid_usage", "input_fluid", "output_fluid", "icon_col", "icon_row"],
        "properties": {
          "key": { "$ref": "#/$defs/key" },
          "localized_name": { "$ref": "#/$defs/localizedName" },
          "max_power_output": { "type": "number", "exclusiveMinimum": 0, "description": "Electric output in W at full plasma flow." },
          "fluid_usage": { "type": "number", "exclusiveMinimum": 0, "description": "Fluid units per second." },
          "input_fluid": { "$ref": "#/$defs/key" },
          "output_fluid": { "$ref": "#/$defs/key" },
          "icon_col": { "$ref": "#/$defs/iconIndex" },
          "icon_row": { "$ref": "#/$defs/iconIndex" }
        }
      }
    },
    "belts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "localized_name", "speed", "icon_col", "icon_row"],
        "properties": {
          "key": { "$ref": "#/$defs/key" },
          "localized_name": { "$ref": "#/$defs/localizedName" },
          "speed": { "type": "number", "exclusiveMinimum": 0, "description": "Tiles per tick." },
          "icon_col": { "$ref": "#/$defs/iconIndex" },
          "icon_row": { "$ref": "#/$defs/iconIndex" }
        }
      }
    },
    "beacon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "energy_usage", "distribution_effectivity", "module_slots", "allowed_effects", "profile"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "energy_usage": { "type": "number", "exclusiveMinimum": 0 },
        "distribution_effectivity": { "type": "number", "exclusiveMinimum": 0 },
        "distribution_effectivity_bonus_per_quality_level": { "type": "number" },
        "module_slots": { "type": "integer", "minimum": 1 },
        "allowed_effects": { "$ref": "#/$defs/effectNames" },
        "profile": { "type": "array", "items": { "type": "number" }, "minItems": 1, "description": "Effect multiplier by number of beacons affecting one machine, starting at one beacon." }
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_key", "category", "tier", "effect"],
        "properties": {
          "item_key": { "$ref": "#/$defs/key" },
          "category": { "type": "string" },
          "tier": { "type": "integer", "minimum": 1 },
          "effect": { "$ref": "#/$defs/effect" },
          "effect_by_quality": { "type": "object", "additionalProperties": { "$ref": "#/$defs/effect" }, "description": "Effects by quality key." }
        }
      }
    },
    "agricultural_tower": {
      "type": "array",
      "items": {
        "type": "object",
        "allOf": [{ "$ref": "#/$defs/machine" }],
        "required": ["plots", "harvest_energy"],
        "properties": {
          "radius": { "type": "number", "minimum": 0 },
          "plots": { "type": "integer", "minimum": 1, "description": "Number of plants one tower tends." },
          "harvest_energy": { "type": "number", "exclusiveMinimum": 0, "description": "Electric energy in J for one harvest and the replanting, measured in the game." }
        },
        "unevaluatedProperties": false
      }
    },
    "qualities": {
      "description": "Quality levels from lowest to highest.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "localized_name", "level", "next_probability", "chain_probability", "icon_col", "icon_row"],
        "properties": {
          "key": { "$ref": "#/$defs/key" },
          "localized_name": { "$ref": "#/$defs/localizedName" },
          "level": { "type": "integer", "minimum": 0 },
          "next": { "$ref": "#/$defs/key", "description": "The quality a raise leads to. Missing for the highest quality." },
          "next_probability": { "type": "number", "minimum": 0, "description": "Chance of a raise per 100% quality effect." },
          "chain_probability": { "type": "number", "minimum": 0, "maximum": 1, "description": "Chance of one more raise after a raise reached this quality." },
          "icon_col": { "$ref": "#/$defs/iconIndex" },
          "icon_row": { "$ref": "#/$defs/iconIndex" }
        }
      }
    },
    "rocket_lift_weight": { "type": "number", "exclusiveMinimum": 0, "description": "Rocket cargo capacity in grams." },
    "recipe_productivity": {
      "description": "Technologies that raise the productivity of recipes per level.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "localized_name", "order", "effects", "icon_col", "icon_row"],
        "properties": {
          "key": { "$ref": "#/$defs/key" },
          "localized_name": { "$ref": "#/$defs/localizedName" },
          "order": { "type": "string" },
          "max_level": { "type": "integer", "minimum": 1, "description": "Highest level. Absent for infinite research." },
          "effects": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["recipe", "change"],
              "properties": {
                "recipe": { "$ref": "#/$defs/key" },
                "change": { "type": "number", "description": "Productivity bonus per level, such as 0.1 for +10%." }
              }
            }
          },
          "icon_col": { "$ref": "#/$defs/iconIndex" },
          "icon_row": { "$ref": "#/$defs/iconIndex" }
        }
      }
    },
    "planets": {
      "description": "Planets and space surfaces. Surfaces have no resources.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "localized_name", "order", "surface_properties", "solar_factor", "requires_heating", "resources", "icon_col", "icon_row"],
        "properties": {
          "key": { "$ref": "#/$defs/key" },
          "localized_name": { "$ref": "#/$defs/localizedName" },
          "order": { "type": "string" },
          "surface_properties": { "type": "object", "additionalProperties": { "type": "number" }, "description": "Values that differ from the surface property defaults." },
          "requires_heating": { "type": "boolean", "description": "True if entities freeze here without heat." },
          "solar_factor": { "type": "number", "minimum": 0, "maximum": 1, "description": "Average light level over a day. Solar panels produce this share of their peak." },
          "resources": {
            "type": "object",
            "additionalProperties": false,
            "required": ["resource", "offshore", "plants", "asteroid"],
            "properties": {
              "resource": { "$ref": "#/$defs/keyList" },
              "offshore": { "$ref": "#/$defs/keyList" },
              "plants": { "$ref": "#/$defs/keyList" },
              "asteroid": { "$ref": "#/$defs/keyList", "description": "Asteroid chunks that a space platform collects here." }
            }
          },
          "icon_col": { "$ref": "#/$defs/iconIndex" },
          "icon_row": { "$ref": "#/$defs/iconIndex" }
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "localized_name", "category", "mining_time", "results", "icon_col", "icon_row"],
        "properties": {
          "key": { "$ref": "#/$defs/key" },
          "localized_name": { "$ref": "#/$defs/localizedName" },
          "category": { "type": "string" },
          "mining_time": { "type": "number", "exclusiveMinimum": 0 },
          "results": { "type": "array", "items": { "$ref": "#/$defs/product" }, "minItems": 1 },
          "required_fluid": { "$ref": "#/$defs/key" },
          "fluid_amount": { "type": "number", "exclusiveMinimum": 0, "description": "Fluid per 10 mining cycles." },
          "infinite": { "const": true },
          "order": { "type": "string" },
          "icon_col": { "$ref": "#/$defs/iconIndex" },
          "icon_row": { "$ref": "#/$defs/iconIndex" }
        }
      }
    },
    "plants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "localized_name", "order", "seed", "growth_ticks", "results", "icon_col", "icon_row"],
        "properties": {
          "key": { "$ref": "#/$defs/key" },
          "localized_name": { "$ref": "#/$defs/localizedName" },
          "order": { "type": "string" },
          "seed": { "$ref": "#/$defs/key" },
          "growth_ticks": { "type": "integer", "minimum": 1 },
          "results": { "type": "array", "items": { "$ref": "#/$defs/product" }, "minItems": 1 },
          "surface_conditions": { "$ref": "#/$defs/surfaceConditions" },
          "icon_col": { "$ref": "#/$defs/iconIndex" },
          "icon_row": { "$ref": "#/$defs/iconIndex" }
        }
      }
    },
    "surface_properties": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "default_value"],
        "properties": {
          "name": { "$ref": "#/$defs/key" },
          "default_value": { "type": "number" }
        }
      }
    },
    "sprites": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hash", "width", "height", "extra"],
      "properties": {
        "hash": { "type": "string", "pattern": "^[0-9a-f]{32}$", "description": "MD5 of images/sprite-sheet-<hash>.png." },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "extra": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "icon_col", "icon_row"],
            "properties": {
              "name": { "type": "string" },
              "icon_col": { "$ref": "#/$defs/iconIndex" },
              "icon_row": { "$ref": "#/$defs/iconIndex" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "keyList": { "type": "array", "items": { "$ref": "#/$defs/key" } },
    "localizedName": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en"],
      "properties": { "en": { "type": "string", "minLength": 1 } }
    },
    "iconIndex": { "type": "integer", "minimum": 0, "description": "Cell position in the sprite sheet." },
    "ingredient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name", "amount"],
      "properties": {
        "type": { "enum": ["item", "fluid"] },
        "name": { "$ref": "#/$defs/key" },
        "amount": { "type": "number", "minimum": 0 }
      }
    },
    "product": {
      "description": "A recipe or mining result. amount is the expected amount per craft, with probabilities and extra_count_fraction already applied.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name", "amount"],
      "properties": {
        "type": { "enum": ["item", "fluid"] },
        "name": { "$ref": "#/$defs/key" },
        "amount": { "type": "number", "minimum": 0 },
        "ignored_by_productivity": { "type": "number", "minimum": 0, "description": "Part of the amount that productivity bonuses do not multiply." },
        "temperature": { "type": "number" },
        "percent_spoiled": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "surfaceConditions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["property"],
        "properties": {
          "property": { "$ref": "#/$defs/key" },
          "min": { "type": "number" },
          "max": { "type": "number" }
        }
      }
    },
    "effectNames": { "type": "array", "items": { "enum": ["speed", "productivity", "consumption", "pollution", "quality"] } },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "speed": { "type": "number" },
        "productivity": { "type": "number" },
        "consumption": { "type": "number" },
        "pollution": { "type": "number" },
        "quality": { "type": "number" }
      }
    },
    "energySource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["electric", "burner", "heat", "fluid", "void"] },
        "fuel_categories": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "fuel_category": { "type": "string", "description": "First entry of fuel_categories." },
        "effectivity": { "type": "number", "exclusiveMinimum": 0 },
        "emissions_per_minute": { "type": "object", "additionalProperties": { "type": "number" } }
      }
    },
    "machine": {
      "description": "Fields shared by all powered machines. energy_usage is in W.",
      "type": "object",
      "required": ["key", "localized_name", "module_slots", "icon_col", "icon_row"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "localized_name": { "$ref": "#/$defs/localizedName" },
        "energy_usage": { "type": "number", "minimum": 0 },
        "energy_source": { "$ref": "#/$defs/energySource" },
        "module_slots": { "type": "integer", "minimum": 0 },
        "allowed_effects": { "$ref": "#/$defs/effectNames" },
        "surface_conditions": { "$ref": "#/$defs/surfaceConditions" },
        "heating_energy": { "type": "number", "minimum": 0, "description": "Heat in W that keeps the machine from freezing on planets that require heating." },
        "icon_col": { "$ref": "#/$defs/iconIndex" },
        "icon_row": { "$ref": "#/$defs/iconIndex" }
      }
    }
  }
}
