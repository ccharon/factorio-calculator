{
  "name": "factorio-calculator",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint && node tools/check-dom-sinks.js",
    "typecheck": "tsc",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "build-data": "node tools/build-data.js",
    "test:browser": "node tests/browser/smoke.js",
    "snapshot:check": "node tests/browser/snapshot.js check",
    "snapshot:record": "node tests/browser/snapshot.js record"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/node": "^26.6.4",
    "ajv": "^8.20.0",
    "jsdom": "^30.1.2",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "puppeteer-core": "^25.12.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@floating-ui/dom": "^1.8.0",
    "d3": "^7.9.0"
  }
}
